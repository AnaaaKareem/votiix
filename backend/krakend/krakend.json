{
  "$schema": "https://www.krakend.io/schema/v2.5/krakend.json",
  "version": 3,
  "name": "Votiix API Gateway",
  "port": 8080,
  "timeout": "10s",
  "cache_ttl": "0s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["Content-Type", "Authorization"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "@comment": "=== HARDWARE EDGE (ESP32 Traffic) ===",
      "endpoint": "/api/v1/kiosk/identity/auth",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [{
        "url_pattern": "/identity/auth-session",
        "host": ["http://votiix-identity:3000"],
        "encoding": "no-op"
      }]
    },
    {
      "endpoint": "/api/v1/kiosk/token/sign",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [{
        "url_pattern": "/token/sign",
        "host": ["http://votiix-token:3001"],
        "encoding": "no-op"
      }]
    },
    {
      "endpoint": "/api/v1/kiosk/token/public-key",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [{
        "url_pattern": "/token/public-key",
        "host": ["http://votiix-token:3001"],
        "encoding": "no-op"
      }]
    },
    {
      "endpoint": "/api/v1/kiosk/vote/commit",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [{
        "url_pattern": "/kiosk/vote/commit",
        "host": ["http://votiix-vote-engine:3002"],
        "encoding": "no-op"
