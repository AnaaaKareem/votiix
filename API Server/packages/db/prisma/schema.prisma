generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// BALLOT DB — 1. GEOGRAPHY & INFRASTRUCTURE
// ==========================================

model Location {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  type            String           // "National, Province, Constituency, Ward"
  parentId        String?          @map("parent_id") @db.Uuid // recursive relationship
  parent          Location?        @relation("LocationHierarchy", fields: [parentId], references: [id])
  children        Location[]       @relation("LocationHierarchy")
  pollingStations PollingStation[]
  contests        Contest[]
  voterRegistries VoterRegistry[]

  @@map("location")
}

model PollingStation {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  address          String
  terminalCapacity Int              @map("terminal_capacity")
  locationId       String           @map("location_id") @db.Uuid
  location         Location         @relation(fields: [locationId], references: [id])
  terminals        Terminal[]
  deviceBindings   DeviceBinding[]
  votePackages     VotePackage[]
  officers         Officer[]

  @@map("polling_station")
}

model Terminal {
  id                 String             @id @map("hardware_id")
  isActive           Boolean            @default(true) @map("is_active")
  mtlsCertThumbprint String             @map("mtls_cert_thumbprint")
  lastHeartbeat      DateTime?          @map("last_heartbeat")
  firmwareVersion    String             @map("firmware_version")
  status             String             // "Online, Offline, Tampered, Maintenance"
  assignedStationId  String?            @map("assigned_station_id") @db.Uuid
  station            PollingStation?    @relation(fields: [assignedStationId], references: [id])
  offlineVoteQueue   OfflineVoteQueue[]

  @@map("terminal")
}

// ==========================================
// BALLOT DB — 2. ELECTION LIFECYCLE
// ==========================================

model Election {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  startDate       DateTime         @map("start_date")
  endDate         DateTime         @map("end_date")
  isMobileEnabled Boolean          @default(true) @map("is_mobile_enabled")
  status          String           // "Draft, Registration, Active, Closed, Tallying, Archived, Purged"
  certifiedAt     DateTime?        @map("certified_at")
  rsaPublicKey    String?          @map("rsa_public_key")
  retentionPolicy RetentionPolicy?
  contests        Contest[]
  voterRegistries VoterRegistry[]
  blindTokens     BlindToken[]

  @@map("election")
}

model RetentionPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  electionId           String   @unique @map("election_id") @db.Uuid
  election             Election @relation(fields: [electionId], references: [id])
  piiPurgeDays         Int      @map("pii_purge_days")
  wipeBiometricHashes  Boolean  @default(true) @map("wipe_biometric_hashes")
  archiveAfterDays     Int      @map("archive_after_days")

  @@map("retention_policy")
}

model Contest {
  id             String         @id @default(uuid()) @db.Uuid
  electionId     String         @map("election_id") @db.Uuid
  election       Election       @relation(fields: [electionId], references: [id])
  locationId     String         @map("location_id") @db.Uuid
  location       Location       @relation(fields: [locationId], references: [id])
  officeTitle    String         @map("office_title")
  countingLogic  String         @map("counting_logic")
  seatsAvailable Int            @map("seats_available")
  candidates     Candidate[]
  votePackages   VotePackage[]
  tallyResults   TallyResult[]

  @@map("contest")
}

// ==========================================
// BALLOT DB — 3. CANDIDATES & PARTIES
// ==========================================

model Party {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  shortCode  String      @map("short_code")
  logoUrl    String?     @map("logo_url")
  candidates Candidate[]

  @@map("party")
}

model Candidate {
  id           String        @id @default(uuid()) @db.Uuid
  contestId    String        @map("contest_id") @db.Uuid
  contest      Contest       @relation(fields: [contestId], references: [id])
  partyId      String?       @map("party_id") @db.Uuid
  party        Party?        @relation(fields: [partyId], references: [id])
  name         String
  photoUrl     String?       @map("photo_url")
  listPosition Int?          @map("list_position")
  tallyResult  TallyResult?

  @@map("candidate")
}

// ==========================================
// BALLOT DB — 4. VOTER IDENTITY BRIDGE
// ==========================================

model VoterRegistry {
  id             String       @id @default(uuid()) @db.Uuid
  electionId     String       @map("election_id") @db.Uuid
  election       Election     @relation(fields: [electionId], references: [id])
  mosipUin       String       @map("mosip_uin")
  locationId     String       @map("location_id") @db.Uuid
  location       Location     @relation(fields: [locationId], references: [id])
  hasVoted       Boolean      @default(false) @map("has_voted")
  checkedInAt    DateTime?    @map("checked_in_at")
  votedAt        DateTime?    @map("voted_at")
  votingMethod   String?      @map("voting_method")
  authSessionId  String?      @unique @map("auth_session_id") @db.Uuid
  authSession    AuthSession? @relation(fields: [authSessionId], references: [id])

  @@map("voter_registry")
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  mosipUin      String         @map("mosip_uin")
  jwtToken      String         @map("jwt_token") // We store or hash it here if necessary
  createdAt     DateTime       @default(now()) @map("created_at")
  expiresAt     DateTime       @map("expires_at")
  status        String         // "Active, Locked, TimedOut"
  voterRegistry VoterRegistry?

  @@map("auth_session")
}

// ==========================================
// BALLOT DB — 5. DEVICE BINDING
// ==========================================

model DeviceBinding {
  id                   String         @id @default(uuid()) @db.Uuid
  mosipUin             String         @map("mosip_uin")
  hardwareId           String         @map("hardware_id")
  pollingStationId     String         @map("polling_station_id") @db.Uuid
  pollingStation       PollingStation @relation(fields: [pollingStationId], references: [id])
  registeringOfficerId String         @map("registering_officer_id") @db.Uuid
  registeringOfficer   Officer        @relation(fields: [registeringOfficerId], references: [id])
  bindingDate          DateTime       @default(now()) @map("binding_date")

  @@map("device_binding")
}

// ==========================================
// BALLOT DB — 6. BLIND TOKENS & VOTES
// ==========================================

model BlindToken {
  hash           String        @id @map("token_hash") // SHA-256 of unblinded token
  electionId     String        @map("election_id") @db.Uuid
  election       Election      @relation(fields: [electionId], references: [id])
  isUsed         Boolean       @default(false) @map("is_used")
  issuedAt       DateTime      @default(now()) @map("issued_at")
  usedAt         DateTime?     @map("used_at")
  votePackage    VotePackage?

  @@map("blind_token")
}

model VotePackage {
  id                 String          @id @default(uuid()) @db.Uuid
  contestId          String          @map("contest_id") @db.Uuid
  contest            Contest         @relation(fields: [contestId], references: [id])
  pollingStationId   String?         @map("polling_station_id") @db.Uuid
  pollingStation     PollingStation? @relation(fields: [pollingStationId], references: [id])
  selections         Json            // Array of candidate_ids or party_ids
  method             String          // "Mobile or Station"
  deviceSignature    String          @map("device_signature")
  blindTokenHash     String          @unique @map("blind_token_hash")
  blindToken         BlindToken      @relation(fields: [blindTokenHash], references: [hash])
  timestamp          DateTime        @default(now())

  @@map("vote_package")
}

// ==========================================
// BALLOT DB — 7. OFFLINE QUEUE
// ==========================================

model OfflineVoteQueue {
  id               String   @id @default(uuid()) @db.Uuid
  hardwareId       String   @map("hardware_id")
  terminal         Terminal @relation(fields: [hardwareId], references: [id])
  encryptedPayload Json     @map("encrypted_payload")
  capturedAt       DateTime @map("captured_at")
  isSynced         Boolean  @default(false) @map("is_synced")
  syncedAt         DateTime? @map("synced_at")

  @@map("offline_vote_queue")
}

// ==========================================
// BALLOT DB — 8. TALLYING & RESULTS
// ==========================================

model TallyResult {
  id            String    @id @default(uuid()) @db.Uuid
  contestId     String    @map("contest_id") @db.Uuid
  contest       Contest   @relation(fields: [contestId], references: [id])
  candidateId   String    @unique @map("candidate_id") @db.Uuid
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  voteCount     Int       @default(0) @map("vote_count")
  weightedCount Float     @default(0) @map("weighted_count")
  lastUpdated   DateTime  @default(now()) @updatedAt @map("last_updated")
  status        String    @default("Provisional")

  @@map("tally_result")
}

// ==========================================
// BALLOT DB — 9. ADMIN & AUDIT
// ==========================================

model Admin {
  id           String @id @default(uuid()) @db.Uuid
  username     String @unique
  passwordHash String @map("password_hash")
  role         String // "Admin, DPO"

  @@map("admin")
}

model Officer {
  id                String          @id @default(uuid()) @db.Uuid
  officerId         String          @unique @map("officer_id")
  username          String          @unique
  passwordHash      String          @map("password_hash")
  fingerprintHash   String?         @map("fingerprint_hash")
  assignedStationId String?         @map("assigned_station_id") @db.Uuid
  station           PollingStation? @relation(fields: [assignedStationId], references: [id])
  role              String          // "Senior Officer, Officer"
  deviceBindings    DeviceBinding[]

  @@map("officer")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid // Admin or Officer ID
  actorType  String   @map("actor_type") // Admin, Officer, System
  action     String   // "LOGIN, OPEN_POLLS, CLOSE_POLLS, WIPE_DATA, VOTE_CAST, TERMINAL_ALERT"
  timestamp  DateTime @default(now())
  metadata   String?  // JSON string or longtext: "Digital proof, hashes, IP, terminal_id"

  @@map("audit_log")
}
